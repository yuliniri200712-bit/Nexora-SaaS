{
  "name": "nexora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @nexora/api\" \"npm run dev -w @nexora/web\"",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:generate": "npm run db:generate -w @nexora/api",
    "db:migrate:dev": "npm run db:migrate -w @nexora/api",
    "build": "npm run build -w @nexora/shared && npm run build -w @nexora/api && npm run build -w @nexora/web",
    "typecheck": "npm run build -w @nexora/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages scripts tests",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "format:check": "prettier --check apps packages tests scripts",
    "db:prepare:test": "node scripts/prepare-test-db.mjs",
    "test:db:up": "docker compose -f compose.test.yaml up -d --wait && node scripts/prepare-test-db.mjs",
    "test:db:down": "docker compose -f compose.test.yaml down -v",
    "test:integration:local": "node scripts/with-test-db.mjs",
    "dev:test:api": "node scripts/start-test-api.mjs",
    "predev": "npm run build -w @nexora/shared",
    "docs:api": "npm run build -w @nexora/shared && node scripts/generate-openapi.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
